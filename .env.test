# Test Environment Variables
# Copy this file to .env.test and fill in the values

# MongoDB Test Database
TEST_MONGO_URI=mongodb://localhost:27017/flashcard-test

# JWT Configuration
JWT_KEY=test-jwt-key
JWT_SECRET=test-jwt-secret

# Cloudinary Configuration (optional for unit tests)
CLOUD_NAME=test-cloud
CLOUD_API_KEY=test-api-key
CLOUD_API_SECRET=test-api-secret

# Server Configuration
PORT=3001
NODE_ENV=test
