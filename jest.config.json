{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "testMatch": ["**/__tests__/**/*.test.ts", "**/?(*.)+(spec|test).ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "collectCoverageFrom": [
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "!**/*.test.ts"
  ]
}
